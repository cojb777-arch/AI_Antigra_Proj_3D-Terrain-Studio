# データベース接続 (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/accounting_db?schema=public"

# Google Gemini API キー (領収書OCR/自動推論用)
GEMINI_API_KEY="your_gemini_api_key_here"

# Google Cloud Storage (電帳法原本保存用 - 任意)
GCS_BUCKET_NAME="your-receipts-bucket-name"
GCS_PROJECT_ID="your-gcp-project-id"

# 国税庁 インボイス公表API アプリケーションID (任意)
NTA_APP_ID="your_nta_app_id_here"
